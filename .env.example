# ==============================================================================
# Crypto-Apples Environment Variables
# ==============================================================================

# 1. NeonDB Connection String (PostgreSQL)
# Format: postgres://<user>:<password>@<neon_host>/<dbname>?sslmode=require
DATABASE_URL=

# 2. Trigger.dev v3 (Background Scheduled Jobs)
# Ambil dari dashboard https://cloud.trigger.dev (Free Tier)
TRIGGER_SECRET_KEY=

# 3. Gemini API Key (optional / for server-side AI features)
GEMINI_API_KEY=
