{
  "rewrites": [
    {
      "source": "/api/yahoo/chart/:symbol",
      "destination": "/api/yahoo/chart/[symbol]"
    },
    {
      "source": "/api/yahoo/quotes",
      "destination": "/api/yahoo/quotes"
    },
    {
      "source": "/api/logo",
      "destination": "/api/logo"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
